# ============================================
# Betting Analysis Squad — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# === APIS DE DADOS ESPORTIVOS ===
# Obtenha em: https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=sua_chave_aqui

# === API DE NOTICIAS ===
# Obtenha em: https://newsapi.org/register
NEWSAPI_KEY=sua_chave_aqui

# === API DE CLIMA ===
# Obtenha em: https://openweathermap.org/api
OPENWEATHER_KEY=sua_chave_aqui

# === API DE ODDS ===
# Obtenha em: https://the-odds-api.com
ODDS_API_KEY=sua_chave_aqui

# === CONFIGURAÇÕES DA BANCA ===
# Valor total da sua banca em R$
USER_BANKROLL=1000

# Estratégia de staking: kelly | flat | progressive
STAKING_METHOD=kelly

# Fração do Kelly (0.25 = 25% do Kelly completo — conservador)
KELLY_FRACTION=0.25

# Stake máxima por aposta em % da banca
MAX_STAKE_PCT=5

# === TELEGRAM (OPCIONAL — alertas) ===
# Obtenha via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Janela de deduplicação em ms — bloqueia reenvio da mesma mensagem neste período (padrão: 600000 = 10 min)
TELEGRAM_DEDUP_WINDOW_MS=600000

# === MEMPALACE (sistema de memória vetorial) ===
# Caminho para o Python com MemPalace instalado
MEMPALACE_PYTHON=C:\Users\PCHOME01\AppData\Local\Programs\Python\Python312\python.exe
# Caminho do palace (criado automaticamente pelo mempalace init)
MEMPALACE_PALACE_PATH=C:\Users\PCHOME01\.mempalace\palace
# Nome da wing do projeto
MEMPALACE_WING=squadfutbol

# === MODO DEMO (sem chaves de API) ===
# true = usa dados simulados para teste
DEMO_MODE=false

# === CONFIGURAÇÕES GERAIS ===
# Idioma das notícias: pt,en,es
NEWS_LANGUAGE=pt,en

# Horas para buscar notícias retroativamente
NEWS_LOOKBACK_HOURS=72

# EV mínimo para considerar uma aposta (0.05 = 5%)
MIN_EV_THRESHOLD=0.05

# Score mínimo de confiança para recomendar aposta (0-100)
MIN_CONFIDENCE_SCORE=60

# Ligas monitoradas (separadas por vírgula)
MONITORED_LEAGUES=39,140,135,78,61,2,71
# 39=Premier League, 140=La Liga, 135=Serie A, 78=Bundesliga, 61=Ligue 1, 2=Champions League, 71=Brasileirão

# === AUTO MONITOR (modo automático) ===
# Intervalo entre scans em minutos (padrão: 60)
SCAN_INTERVAL_MINUTES=60

# Janela de tempo para buscar jogos à frente em horas (padrão: 8)
HOURS_AHEAD=8

# Máximo de partidas analisadas por scan (padrão: 10)
MAX_MATCHES_PER_SCAN=10

# Abrir browser visível para debug (false = invisível)
HEADLESS=true

# === SHARP AGENTS — IA para análise independente dos 7 lendas ===
# Escolha o provider: groq (padrão) ou openai
AI_PROVIDER=groq

# Gemini (Google) — não mais utilizado (migrado para Groq)
# GEMINI_API_KEY=sua_chave_aqui
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI — obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sua_chave_aqui
OPENAI_MODEL=gpt-4o-mini

# === OBSIDIAN (OPCIONAL — exportar análises para o vault) ===
# Caminho absoluto para a raiz do seu vault do Obsidian
# Exemplos:
#   Windows: C:/Users/SeuNome/Documents/MeuVault
#   Mac/Linux: /Users/SeuNome/Documents/MeuVault
OBSIDIAN_VAULT_PATH=seu_caminho_aqui

# Pasta dentro do vault onde as notas serão salvas (padrão: "Apostas Futebol")
OBSIDIAN_FOLDER=Apostas Futebol
